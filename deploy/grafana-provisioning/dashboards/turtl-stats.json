                      "spec": {
                        "dataset": "turtl_db",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH deltas AS (\r\n  SELECT created_at AS ts,  1 AS delta\r\n  FROM analytics_analyticsevent\r\n  WHERE event_type = 'lab_created'\r\n\r\n  UNION ALL\r\n\r\n  SELECT created_at AS ts, -1 AS delta\r\n  FROM analytics_analyticsevent\r\n  WHERE event_type = 'lab_deleted'\r\n)\r\nSELECT\r\n  ts AS time,\r\n  SUM(delta) OVER (ORDER BY ts) AS lab_envs\r\nFROM deltas\r\nWHERE $__timeFilter(ts)\r\nORDER BY ts;\r\n",
                        "sql": {
