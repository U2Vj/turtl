                        "rawSql": "WITH deltas AS (\r\n  SELECT created_at AS ts,  1 AS delta FROM analytics_analyticsevent WHERE event_type='lab_created' AND $__timeFilter(created_at)\r\n  UNION ALL\r\n  SELECT created_at AS ts, -1 AS delta FROM analytics_analyticsevent WHERE event_type='lab_deleted' AND $__timeFilter(created_at)\r\n)\r\nSELECT MAX(running) AS max_parallel FROM (\r\n  SELECT SUM(delta) OVER (ORDER BY ts) AS running FROM deltas\r\n) t;\r\n",
