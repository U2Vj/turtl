POSTGRES_PASSWORD=turtl_password

REDIS_PASSWORD=<insert redis password here>

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<insert grafana admin password here>
GRAFANA_DB_USER=grafana_reader
GRAFANA_DB_PASSWORD=<insert grafana reader password here>

PROXMOX_HOST=<insert Proxmox IP and port here>
